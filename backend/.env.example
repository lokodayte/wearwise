PORT=3000

# Supabase (from your project settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (GPT-4o Vision)
OPENAI_API_KEY=sk-...

# remove.bg (optional — if not set, background removal is skipped)
REMOVE_BG_API_KEY=your-remove-bg-key

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=wearwise-garments
R2_PUBLIC_URL=https://cdn.yourdomain.com   # optional CDN prefix

# Anthropic Claude (used in later phases)
ANTHROPIC_API_KEY=sk-ant-...

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081
